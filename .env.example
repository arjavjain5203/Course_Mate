# CourseMate AI backend configuration
# Copy this file to .env and replace placeholders with your own values.

# Path to a Firebase Admin SDK service-account JSON file.
# Keep the JSON file outside version control.
FIREBASE_CREDENTIALS_PATH=path/to/firebase-service-account.json

# For hosted deployments, use the minified JSON contents instead of a file path.
# Do not commit this value or place it in frontend code.
FIREBASE_CREDENTIALS_JSON=

# Optional: PostgreSQL connection string. If omitted, local SQLite is used.
DATABASE_URL=

# AI provider credentials
MISTRAL_API_KEY=replace-with-your-mistral-api-key
GOOGLE_API_KEY=replace-with-your-google-ai-api-key
HUGGINGFACEHUB_API_TOKEN=replace-with-your-hugging-face-token
